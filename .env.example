# Copy to .env. Never commit real values.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5436/crm_developer
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5436/crm_developer_test

# Auth — JWT_ACCESS_SECRET must be at least 32 random characters.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Seeded platform super user (npm run db:seed). Password: at least 12 characters.
PLATFORM_SUPER_USER_EMAIL=platform@example.com
PLATFORM_SUPER_USER_PASSWORD=change-me-please
PLATFORM_SUPER_USER_FIRST_NAME=Platform
PLATFORM_SUPER_USER_LAST_NAME=Owner

# Frontend origin, used in invite links (crm-developer-ui dev server).
APP_BASE_URL=http://localhost:3200
