{
  "name": "crm-developer-api",
  "version": "0.1.0",
  "description": "Invespy Developer CRM — multi-tenant backend API (platform + tenant planes).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"{src,test,seeds}/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"{src,test,seeds}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,seeds}/**/*.ts\"",
    "db:migrate": "ts-node -r tsconfig-paths/register src/infrastructure/persistence/migrate.cli.ts",
    "db:seed": "ts-node -r tsconfig-paths/register seeds/seed.cli.ts",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:cov": "jest --config jest.cov.config.js --coverage --runInBand",
    "check:boundaries": "bash scripts/check-boundaries.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0"
  }
}
